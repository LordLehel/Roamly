generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model event_participants {
  event_id Int
  user_id  Int
  events   events @relation(fields: [event_id], references: [event_id], onDelete: Cascade, onUpdate: NoAction)
  users    users  @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([event_id, user_id])
}

model events {
  event_id           Int                  @id @default(autoincrement())
  group_id           Int
  creator_id         Int
  visibility_id      Int
  title              String               @db.VarChar(64)
  description        String?              @db.VarChar(255)
  start_time         DateTime             @db.Timestamp(6)
  end_time           DateTime             @db.Timestamp(6)
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime             @updatedAt @db.Timestamp(6)
  uuid               String               @unique @db.Uuid
  event_participants event_participants[]
  creator            users                @relation(fields: [creator_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  groups             groups               @relation(fields: [group_id], references: [group_id], onDelete: Cascade, onUpdate: NoAction)
  visibility         visibilities         @relation(fields: [visibility_id], references: [visibility_id])
}

model visibilities {
  visibility_id Int      @id @default(autoincrement())
  name          String   @unique @db.VarChar(64)
  events        events[]
}

model group_profiles {
  user_id     Int
  group_id    Int
  role_id     Int
  nickname    String? @unique @db.VarChar(64)
  description String? @db.VarChar(255)
  groups      groups  @relation(fields: [group_id], references: [group_id], onDelete: Cascade, onUpdate: NoAction)
  roles       roles   @relation(fields: [role_id], references: [role_id], onUpdate: NoAction)
  users       users   @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, group_id])
}

model groups {
  group_id       Int              @id @default(autoincrement())
  uuid           String           @unique @default(uuid()) @db.Uuid
  name           String           @db.VarChar(255)
  current_size   Int              @db.SmallInt
  created_at     DateTime         @default(now()) @db.Timestamp(6)
  updated_at     DateTime         @updatedAt @db.Timestamp(6)
  events         events[]
  file_shares    file_shares[]
  files          files[]
  group_profiles group_profiles[]
}

model media_files {
  file_id     Int     @id
  description String? @db.VarChar(255)
  files       files   @relation(fields: [file_id], references: [file_id], onDelete: Cascade, onUpdate: NoAction)
}

model roles {
  role_id        Int              @id @default(autoincrement())
  type           String           @unique @db.VarChar(255)
  group_profiles group_profiles[]
}

model users {
  user_id            Int                  @id @default(autoincrement())
  uuid               String               @unique @default(uuid()) @db.Uuid
  username           String               @db.VarChar(64)
  email              String               @unique @db.VarChar(254)
  password           String               @db.VarChar(255)
  profile_image_url  String?
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime             @updatedAt @db.Timestamp(6)
  phone_number       String?              @unique @db.VarChar(20)
  event_participants event_participants[]
  events             events[]
  file_shares        file_shares[]
  uploaded_files     files[]              @relation("FilesUploadedByUser")
  owned_files        files[]              @relation("FilesOwnedByUser")
  group_profiles     group_profiles[]
}

model documents {
  file_id       Int       @id
  issue_date    DateTime? @db.Date
  expiry_date   DateTime? @db.Date
  document_type String?   @db.VarChar(64)
  files         files     @relation(fields: [file_id], references: [file_id], onDelete: Cascade, onUpdate: NoAction)
}

model files {
  file_id         Int           @id @default(autoincrement())
  file_name       String?       @db.VarChar(255)
  file_url        String
  file_size       Int?
  mime_type       String?       @db.VarChar(32)
  upload_datetime DateTime?     @default(now()) @db.Timestamp(6)
  uploaded_by     Int?
  ownership_type  String        @db.VarChar(255)
  user_id         Int?
  group_id        Int?
  created_at      DateTime      @default(now()) @db.Timestamp(6)
  updated_at      DateTime      @updatedAt @db.Timestamp(6)
  documents       documents?
  file_shares     file_shares[]
  groups          groups?       @relation(fields: [group_id], references: [group_id], onDelete: Cascade, onUpdate: NoAction)
  creator         users?        @relation("FilesUploadedByUser", fields: [uploaded_by], references: [user_id], onUpdate: NoAction)
  owner           users?        @relation("FilesOwnedByUser", fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  media_files     media_files?
}

model file_shares {
  file_id      Int
  group_id     Int
  shared_by    Int?
  shared_at    DateTime @default(now()) @db.Timestamp(6)
  access_level String   @default("ALL") @db.VarChar(32)
  files        files    @relation(fields: [file_id], references: [file_id], onDelete: Cascade, onUpdate: NoAction)
  groups       groups   @relation(fields: [group_id], references: [group_id], onDelete: Cascade, onUpdate: NoAction)
  users        users?   @relation(fields: [shared_by], references: [user_id], onUpdate: NoAction)

  @@id([file_id, group_id])
}

model pending_users {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(254)
  username     String   @db.VarChar(64)
  password     String   @db.VarChar(255)
  phone_number String?  @db.VarChar(20)
  otp          String   @db.VarChar(6)
  expires_at   DateTime @db.Timestamp(6)
  created_at   DateTime @default(now()) @db.Timestamp(6)
}

model password_resets {
  id         Int      @id @default(autoincrement())
  email      String   @unique @db.VarChar(254)
  otp        String   @db.VarChar(6)
  expires_at DateTime @db.Timestamp(6)
  created_at DateTime @default(now()) @db.Timestamp(6)
}
